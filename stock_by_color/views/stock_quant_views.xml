<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inherit_color" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.color</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="before">
                <header>
                    <button name="action_group_by_color" 
                            string="By Color" 
                            type="object" 
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>