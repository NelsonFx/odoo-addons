<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista pivot: Tipo > Color > Marca, con la cantidad -->
    <record id="view_stock_quant_filament_pivot" model="ir.ui.view">
        <field name="name">stock.quant.filament.pivot</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <pivot string="Inventario de filamentos" sample="1">
                <field name="tipo_value" type="row"/>
                <field name="color_value" type="row"/>
                <field name="marca_value" type="row"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_stock_quant_filament_list" model="ir.ui.view">
        <field name="name">stock.quant.filament.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list string="Inventario de filamentos" create="0" edit="0" delete="0">
                <field name="product_id"/>
                <field name="tipo_value"/>
                <field name="marca_value"/>
                <field name="color_value"/>
                <field name="location_id"/>
                <field name="quantity" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- Filtros y agrupaciones -->
    <record id="view_stock_quant_filament_search" model="ir.ui.view">
        <field name="name">stock.quant.filament.search</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search string="Inventario de filamentos">
                <field name="product_id"/>
                <field name="color_value"/>
                <field name="tipo_value"/>
                <field name="marca_value"/>
                <field name="location_id"/>
                <filter name="filter_filament" string="Almacén Filament"
                        domain="[('location_id.warehouse_id.name', '=', 'Filament')]"/>
                <filter name="filter_positive" string="Con existencia"
                        domain="[('quantity', '>', 0)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_tipo" string="Tipo" context="{'group_by': 'tipo_value'}"/>
                    <filter name="group_marca" string="Marca" context="{'group_by': 'marca_value'}"/>
                    <filter name="group_color" string="Color" context="{'group_by': 'color_value'}"/>
                    <filter name="group_location" string="Ubicación" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_quant_filament" model="ir.actions.act_window">
        <field name="name">Inventario de filamentos</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('location_id.usage', '=', 'internal')]</field>
        <field name="context">{'search_default_filter_filament': 1, 'search_default_filter_positive': 1}</field>
        <field name="search_view_id" ref="view_stock_quant_filament_search"/>
    </record>

    <record id="action_stock_quant_filament_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_stock_quant_filament_pivot"/>
        <field name="act_window_id" ref="action_stock_quant_filament"/>
    </record>

    <record id="action_stock_quant_filament_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_stock_quant_filament_list"/>
        <field name="act_window_id" ref="action_stock_quant_filament"/>
    </record>

    <menuitem id="menu_stock_quant_filament"
              name="Inventario de filamentos"
              parent="stock.menu_warehouse_report"
              action="action_stock_quant_filament"
              groups="stock.group_stock_user"
              sequence="25"/>
</odoo>
